# Mongo root user - for admin purposes
DB_ROOT_USERNAME="root"
DB_ROOT_PASSWORD="root"

# Mongo weebify user - used by the app
DB_WEEBIFY_USERNAME="weebify"
DB_WEEBIFY_PASSWORD="weebify"

# The first user to be created
WEEBIFY_USER="admin"
# Create your own password hash using argon2id, this one is "admin"
WEEBIFY_PASSWORD_HASH="\$argon2id\$v=19\$m=16,t=2,p=1\$QTZnc0hXeURhcUpSRlNrYQ\$905G/d3YBj4PWBvF7AaeiA"

# MeiliSearch config
SEARCH_HOST="http://search:7700/"
SEARCH_KEY="weebifyEpicMasterKey"

# Connection string for the app
# Make sure to update with relavant credentials (DB_WEEBIFY_)
DB_URL="mongodb://weebify:weebify@database:27017/weebify?authMechanism=DEFAULT&authSource=admin"

# S3 config
# NOTE: localhost/private IPs will result in localhost/private signed URLs
# It might work if you only upload videos from local network / machine,
# but please use a publicly accessible URL
# If you really care about bandwidth/performance on a local S3 instance,
# set up a split horizon DNS
S3_BUCKET="weebify"
# this sample config ignores the adivice above, since it is meant for testing / POC
S3_ENDPOINT="s3"
S3_PORT=9000
S3_ACCESS_KEY="weebifydev"
S3_SECRET="weebifydev"
S3_SSL=0

# JWT config
JWT_KEY="REAL JWT KEY!!!"

# Publicly accessible URL for your S3 bucket
S3_PUBLIC_URL="/cdn/weebify"
