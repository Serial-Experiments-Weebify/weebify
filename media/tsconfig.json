{
    "compilerOptions": {
        "target": "ES2018",
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "module": "commonjs",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "strictPropertyInitialization": false,
        "skipLibCheck": true,
        "outDir": "build",
        "resolveJsonModule": true,
        "lib": [
            "ES2018"
        ]
    },
    "include": [
        "src/**/*.ts"
    ]
}